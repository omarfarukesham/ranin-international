<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="400" height="800" viewBox="0 0 400 800" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="phoneGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4299E1"/>
      <stop offset="100%" style="stop-color:#2B6CB0"/>
    </linearGradient>
  </defs>
  
  <!-- Phone Frame -->
  <rect x="40" y="20" width="320" height="760" rx="40" fill="#1A202C"/>
  <rect x="50" y="30" width="300" height="740" rx="35" fill="white"/>
  
  <!-- App Content -->
  <rect x="50" y="30" width="300" height="60" rx="35" fill="#4299E1"/>
  <text x="70" y="70" fill="white" font-family="Arial" font-weight="bold" font-size="24">SHUKR</text>
  
  <!-- App Content Blocks -->
  <rect x="70" y="110" width="260" height="100" rx="10" fill="#EBF8FF"/>
  <rect x="70" y="230" width="260" height="100" rx="10" fill="#EBF8FF"/>
  <rect x="70" y="350" width="260" height="100" rx="10" fill="#EBF8FF"/>
  
  <!-- Navigation Bar -->
  <rect x="50" y="700" width="300" height="70" rx="35" fill="#F7FAFC"/>
  <circle cx="100" cy="735" r="15" fill="#4299E1"/>
  <circle cx="200" cy="735" r="15" fill="#4299E1"/>
  <circle cx="300" cy="735" r="15" fill="#4299E1"/>
</svg>